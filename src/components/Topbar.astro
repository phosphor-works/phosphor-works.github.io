// SPDX-License-Identifier: GPL-3.0-or-later
//
// Sticky top navigation, rendered once at the BaseLayout level.
// Three-zone grid: brand mark on the left, nav links centered,
// controls (search / theme / GitHub) on the right.
//
// IA: the site leads with the desktop suite.  Four top-level entries:
//   Apps        the five suite apps, from src/data/apps.ts
//   Developers  libraries, guides and the API reference
//   News        latest posts + RSS
//   About       project, contributing, brand, palette
// Each entry opens a panel on hover or focus; clicking the label
// still goes to that section's landing page.
//
// Below 720px the centered link list collapses into the hamburger
// drawer; the right-side controls stay inline so search and
// theme-flip remain one tap away.

import { getCollection } from "astro:content";
import SiteSearch from "./SiteSearch.astro";
import ThemeToggle from "./ThemeToggle.astro";
import { APPS } from "../data/apps";

interface Props {
    homeHref?: string;
    githubHref?: string;
    discordHref?: string;
}

// Latest news posts surface in the News dropdown so the topbar
// doubles as a freshness signal.  Top 3 keeps the panel short.
const latestNews = (await getCollection("news", ({ data }) => !data.draft))
    .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
    .slice(0, 3);

const latestDateFormatter = new Intl.DateTimeFormat("en-US", {
    timeZone: "UTC",
    year: "numeric", month: "long", day: "numeric",
});

const {
    homeHref = "/",
    githubHref = "https://github.com/phosphor-works",
    discordHref = "https://discord.gg/9CQzAptdJ5",
} = Astro.props;

interface NavItem  { label: string; href: string; }
interface NavGroup { label?: string; items: NavItem[]; }
interface NavLink  {
    label: string;
    href: string;
    /** URL prefixes that mark this entry as the current section. */
    match: string[];
    /** Rich app panel instead of grouped text links. */
    apps?: boolean;
    groups?: NavGroup[];
}

const LINKS: NavLink[] = [
    {
        label: "Apps",
        href: "/#apps",
        match: APPS.map(a => a.href),
        apps: true,
        // Text form of the same list, used by the mobile drawer.
        groups: [{ items: APPS.map(a => ({ label: a.name, href: a.href })) }],
    },
    {
        label: "Developers",
        href: "/developers/",
        match: ["/developers/", "/libraries/", "/guides/", "/api/"],
        groups: [
            {
                label: "Build on Phosphor",
                items: [
                    { label: "Overview",          href: "/developers/"     },
                    { label: "Libraries",         href: "/libraries/"      },
                    { label: "Install a library", href: "/guides/install/" },
                ],
            },
            {
                label: "Guides",
                items: [
                    { label: "Shader authoring",  href: "/guides/shaders/" },
                    { label: "Tiling algorithms", href: "/guides/tiling/"  },
                ],
            },
            {
                label: "Reference",
                items: [
                    { label: "API reference", href: "/api/"                     },
                    { label: "Classes",       href: "/api/html/annotated.html"  },
                    { label: "Namespaces",    href: "/api/html/namespaces.html" },
                ],
            },
        ],
    },
    {
        label: "News",
        href: "/news/",
        match: ["/news/"],
        groups: [
            ...(latestNews.length > 0 ? [{
                label: "Latest",
                items: latestNews.map(post => ({
                    label: latestDateFormatter.format(post.data.date),
                    href:  `/news/${post.id}/`,
                })),
            }] : []),
            {
                label: "Subscribe",
                items: [
                    { label: "All news", href: "/news/"   },
                    { label: "RSS feed", href: "/rss.xml" },
                ],
            },
        ],
    },
    {
        label: "About",
        href: "/about/",
        match: ["/about/", "/brand/", "/palette/"],
        groups: [
            {
                items: [
                    { label: "About Phosphor", href: "/about/"              },
                    { label: "Contributing",   href: "/about/contributing/" },
                    { label: "Brand assets",   href: "/brand/"              },
                    { label: "Palette",        href: "/palette/"            },
                    { label: "AI disclosure",  href: "/about/ai-disclosure/" },
                ],
            },
        ],
    },
];

const path = Astro.url.pathname;
const isCurrent = (l: NavLink) => l.match.some(m => !m.includes("#") && path.startsWith(m));
---

<nav class="pz-topbar" aria-label="Primary">
    <a class="pz-home" href={homeHref}>
        {/* Phosphor mark, simplified for 22×22 — fatter, no side cuts
            (those muddy at this size); matches the full-size mark shape. */}
        <svg width="22" height="22" viewBox="96 96 832 832" xmlns="http://www.w3.org/2000/svg" fill="none" aria-hidden="true">
            <defs>
                <linearGradient id="pz-topbar-g" x1="120" y1="120" x2="904" y2="904" gradientUnits="userSpaceOnUse">
                    <stop offset="0"    stop-color="#22D3EE"/>
                    <stop offset="0.45" stop-color="#3B82F6"/>
                    <stop offset="0.75" stop-color="#A855F7"/>
                    <stop offset="1"    stop-color="#F43F5E"/>
                </linearGradient>
                <linearGradient id="pz-topbar-phi" x1="300" y1="240" x2="724" y2="784" gradientUnits="userSpaceOnUse">
                    <stop offset="0"    stop-color="#22D3EE"/>
                    <stop offset="0.55" stop-color="#A855F7"/>
                    <stop offset="1"    stop-color="#F43F5E"/>
                </linearGradient>
            </defs>
            <rect x="96" y="96" width="832" height="832" rx="190" fill="url(#pz-topbar-g)"/>
            <rect class="pz-topbar-inner" x="180" y="180" width="664" height="664" rx="120"/>
            <g fill="url(#pz-topbar-phi)">
                <path d="M583 358L598 362L612 367L626 373L640 381L653 389L665 397L677 407L688 418L699 429L709 442L717 455L724 470L730 485L734 501L736 518L737 535L735 551L731 568L725 584L717 599L707 613L696 626L683 637L670 647L655 656L640 664L625 670L609 675L593 678L576 681L560 681L543 676L543 676L557 665L570 658L582 650L594 642L605 634L614 624L623 615L630 605L637 595L643 585L648 574L652 565L656 555L659 545L663 535L665 526L668 516L669 505L671 494L671 483L670 472L669 460L666 448L662 436L656 424L649 413L641 402L632 391L621 382L609 373L597 365L583 358Z"/>
                <path d="M481 676L464 681L448 681L431 678L415 675L399 670L384 664L369 656L354 647L341 637L328 626L317 613L307 599L299 584L293 568L289 551L287 535L288 518L290 501L294 485L300 470L307 455L315 442L325 429L336 418L347 407L359 397L371 389L384 381L398 373L412 367L426 362L441 358L441 358L427 365L415 373L403 382L392 391L383 402L375 413L368 424L362 436L358 448L355 460L354 472L353 483L353 494L355 505L356 516L359 526L361 535L365 545L368 555L372 565L376 574L381 585L387 595L394 605L401 615L410 624L419 634L430 642L442 650L454 658L467 665L481 676Z"/>
                <path d="M512 196 C548 372 548 652 512 828 C476 652 476 372 512 196 Z"/>
            </g>
        </svg>
        <span>Phosphor</span>
    </a>

    {/* Centered link bar — wide screens only; hidden ≤720px in
        favour of the hamburger drawer below.  Links with `groups`
        expose a hover/focus-within dropdown with grouped sub-page
        lists so deep pages are reachable without leaving the
        topbar.  Click on the parent label still navigates to the
        section landing — the dropdown is a shortcut, not the only
        path. */}
    <div class="pz-links">
        {LINKS.map(l => (
            <div class="pz-link-group">
                <a class="pz-link" href={l.href} aria-current={isCurrent(l) ? "page" : undefined}>
                    {l.label}
                    <svg class="pz-link-chev" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <polyline points="6 9 12 15 18 9"/>
                    </svg>
                </a>
                {l.apps ? (
                    <div class="pz-link-panel pz-apps-panel" role="menu">
                        {APPS.map(app => (
                            <a class="pz-app-item" role="menuitem" href={app.href}>
                                <img src={`/brand/assets/square/dark/${app.icon}.svg`} data-logo="dark" alt="" width="36" height="36" />
                                <img src={`/brand/assets/square/light/${app.icon}.svg`} data-logo="light" alt="" width="36" height="36" />
                                <span class="pz-app-text">
                                    <span class="pz-app-name">{app.name}<span class="pz-app-status">{app.status}</span></span>
                                    <span class="pz-app-role">{app.role}</span>
                                </span>
                            </a>
                        ))}
                    </div>
                ) : (
                    <div class="pz-link-panel" role="menu">
                        {l.groups!.map(g => (
                            <div class="pz-link-section">
                                {g.label && (
                                    <div class="pz-link-eyebrow">{g.label}</div>
                                )}
                                {g.items.map(i => (
                                    <a class="pz-link-sub" role="menuitem" href={i.href}>{i.label}</a>
                                ))}
                            </div>
                        ))}
                    </div>
                )}
            </div>
        ))}
    </div>

    {/* Right-aligned control cluster — search + theme + Discord +
        GitHub icons.  Stays inline at every breakpoint; the hamburger
        drawer only owns the link list, not these controls. */}
    <div class="pz-controls">
        <SiteSearch />
        <ThemeToggle />
        <a class="pz-icon-btn" href={discordHref} aria-label="Discord" rel="noopener" target="_blank">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M20.317 4.37a19.79 19.79 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.865-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.058a.082.082 0 0 0 .031.056 19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028 14.09 14.09 0 0 0 1.226-1.994.076.076 0 0 0-.041-.106 13.107 13.107 0 0 1-1.872-.892.077.077 0 0 1-.008-.128c.126-.094.252-.192.372-.291a.074.074 0 0 1 .077-.01c3.928 1.793 8.18 1.793 12.062 0a.074.074 0 0 1 .078.009c.12.099.246.198.373.292a.077.077 0 0 1-.006.128 12.3 12.3 0 0 1-1.873.892.077.077 0 0 0-.041.106c.36.698.772 1.363 1.225 1.994a.076.076 0 0 0 .084.028 19.84 19.84 0 0 0 6.002-3.03.077.077 0 0 0 .032-.055c.5-5.177-.838-9.674-3.549-13.66a.06.06 0 0 0-.031-.029ZM8.02 15.331c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.956-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.956 2.418-2.157 2.418Zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.955-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.946 2.418-2.157 2.418Z"/>
            </svg>
        </a>
        <a class="pz-icon-btn" href={githubHref} aria-label="GitHub" rel="noopener" target="_blank">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M12 .3a12 12 0 0 0-3.8 23.4c.6.1.8-.3.8-.6v-2c-3.3.7-4-1.6-4-1.6-.5-1.4-1.3-1.7-1.3-1.7-1.1-.7.1-.7.1-.7 1.2.1 1.8 1.2 1.8 1.2 1.1 1.8 2.8 1.3 3.5 1 .1-.8.4-1.3.8-1.6-2.6-.3-5.4-1.3-5.4-5.9 0-1.3.5-2.4 1.2-3.2-.1-.3-.5-1.5.1-3.1 0 0 1-.3 3.3 1.2a11.5 11.5 0 0 1 6 0c2.3-1.5 3.3-1.2 3.3-1.2.6 1.6.2 2.8.1 3.1.7.8 1.2 1.9 1.2 3.2 0 4.6-2.8 5.6-5.5 5.9.5.4.8 1.1.8 2.2v3.3c0 .3.2.7.8.6A12 12 0 0 0 12 .3"/>
            </svg>
        </a>

        {/* Hamburger drawer — narrow screens only.  Pure-CSS via
            <details>: the browser owns keyboard focus, ESC-to-close,
            aria-expanded.  Hidden ≥720px since the centered .pz-links
            row above takes over. */}
        <details class="pz-menu">
            <summary class="pz-menu-toggle" aria-label="Open navigation menu">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="pz-menu-icon-open">
                    <line x1="3" y1="6"  x2="21" y2="6"/>
                    <line x1="3" y1="12" x2="21" y2="12"/>
                    <line x1="3" y1="18" x2="21" y2="18"/>
                </svg>
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="pz-menu-icon-close">
                    <line x1="18" y1="6"  x2="6"  y2="18"/>
                    <line x1="6"  y1="6"  x2="18" y2="18"/>
                </svg>
            </summary>
            {/* Mobile drawer flattens the same group structure
                vertically — parent label, then each group's eyebrow
                + items, then a thin divider to the next section. */}
            <div class="pz-menu-panel">
                {LINKS.map(l => (
                    <div class="pz-menu-section">
                        <a class="pz-menu-link pz-menu-head" href={l.href}>{l.label}</a>
                        {l.groups && l.groups.map(g => (
                            <div class="pz-menu-group">
                                {g.label && <div class="pz-menu-eyebrow">{g.label}</div>}
                                {g.items.map(i => (
                                    <a class="pz-menu-link pz-menu-sub" href={i.href}>{i.label}</a>
                                ))}
                            </div>
                        ))}
                    </div>
                ))}
            </div>
        </details>
    </div>
</nav>
