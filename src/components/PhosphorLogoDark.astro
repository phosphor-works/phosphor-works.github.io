---
// SPDX-FileCopyrightText: 2026 fuddlesworth
// SPDX-License-Identifier: GPL-3.0-or-later
//
// Phosphor umbrella brand mark (dark variant).  Matches the canonical
// file at submodules/branding/svg/dark/phosphor.svg — kept inlined
// here so the home hero can inherit drop-shadow + sizing CSS without
// needing to fetch an external <img src>.  If you edit this, update
// the branding repo's phosphor.svg to match.

interface Props {
    class?: string;
    size?: number;
}

const { class: cls = "hero-logo", size = 120 } = Astro.props;
---

<svg
    class={cls}
    data-logo="dark"
    viewBox="96 96 832 832"
    xmlns="http://www.w3.org/2000/svg"
    fill="none"
    width={size}
    height={size}
    aria-label="Phosphor"
>
    <defs>
        <linearGradient id="ph-border" x1="120" y1="120" x2="904" y2="904" gradientUnits="userSpaceOnUse">
            <stop offset="0"    stop-color="#22D3EE"/>
            <stop offset="0.45" stop-color="#3B82F6"/>
            <stop offset="0.75" stop-color="#A855F7"/>
            <stop offset="1"    stop-color="#F43F5E"/>
        </linearGradient>
        <radialGradient id="ph-bg" cx="0" cy="0" r="1" gradientUnits="userSpaceOnUse"
            gradientTransform="translate(420 360) rotate(135) scale(760)">
            <stop offset="0"    stop-color="#0B1730"/>
            <stop offset="0.65" stop-color="#070F22"/>
            <stop offset="1"    stop-color="#050916"/>
        </radialGradient>
        <linearGradient id="ph-phi" x1="300" y1="240" x2="724" y2="784" gradientUnits="userSpaceOnUse">
            <stop offset="0"    stop-color="#22D3EE"/>
            <stop offset="0.55" stop-color="#A855F7"/>
            <stop offset="1"    stop-color="#F43F5E"/>
        </linearGradient>
        <clipPath id="ph-clip"><rect x="96" y="96" width="832" height="832" rx="190"/></clipPath>
    </defs>
    <rect x="96" y="96" width="832" height="832" rx="190" fill="url(#ph-border)"/>
    <rect x="132" y="132" width="760" height="760" rx="170" fill="url(#ph-bg)"/>
    <g clip-path="url(#ph-clip)">
        <circle cx="320" cy="310" r="440" fill="#22D3EE" opacity="0.08"/>
        <circle cx="790" cy="580" r="460" fill="#A855F7" opacity="0.10"/>
        <circle cx="740" cy="360" r="390" fill="#F43F5E" opacity="0.06"/>
        <g fill="url(#ph-phi)">
            <path d="M583 358L598 362L612 367L626 374L639 381L652 389L664 398L676 408L686 419L695 431L703 444L709 458L714 472L716 487L714 502L702 516L702 516L689 504L685 492L681 480L678 469L674 457L669 446L664 434L658 423L650 412L641 401L632 391L621 382L609 373L597 365L583 358Z"/>
            <path d="M696 553L706 571L704 588L698 603L690 618L680 631L668 643L654 653L640 661L624 669L608 674L592 678L575 681L559 682L541 676L541 676L555 665L569 658L582 651L594 643L605 635L616 626L626 617L635 607L643 598L652 589L660 579L668 570L678 560L696 553Z"/>
            <path d="M483 676L465 682L449 681L432 678L416 674L400 669L384 661L370 653L356 643L344 631L334 618L326 603L320 588L318 571L328 553L328 553L346 560L356 570L364 579L372 589L381 598L389 607L398 617L408 626L419 635L430 643L442 651L455 658L469 665L483 676Z"/>
            <path d="M322 516L310 502L308 487L310 472L315 458L321 444L329 431L338 419L348 408L360 398L372 389L385 381L398 374L412 367L426 362L441 358L441 358L427 365L415 373L403 382L392 391L383 401L374 412L366 423L360 434L355 446L350 457L346 469L343 480L339 492L335 504L322 516Z"/>
            <path d="M512 206 C540 372 540 652 512 818 C484 652 484 372 512 206 Z"/>
        </g>
    </g>
</svg>
