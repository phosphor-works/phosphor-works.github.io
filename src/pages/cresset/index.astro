---
// SPDX-FileCopyrightText: 2026 fuddlesworth
// SPDX-License-Identifier: GPL-3.0-or-later
//
// /cresset/ — the Cresset file explorer.  Cresset is planned: it has a
// name and an icon in the branding repo, and no code yet.  The page
// says what it will be and which existing Phosphor libraries it can
// build on, and claims nothing that does not exist yet.

import BaseLayout from "../../layouts/BaseLayout.astro";
import AppHero from "../../components/AppHero.astro";
import Button from "../../components/Button.astro";
import "../../styles/home.css";

// Libraries that exist today and cover part of the job.  Each body
// follows the library's own entry in src/data/libraries.ts.
const BUILD_ON = [
    {
        title: "File and folder icons",
        body: "XDG icon-theme lookup that follows each theme's inheritance down to Hicolor, with a QML image provider to show the result.",
        lib: "service-icontheme",
    },
    {
        title: "Controls in the suite's style",
        body: "Material 3 QML atoms, such as buttons, text fields, cards and pills, themed entirely through phosphor-theme.",
        lib: "shell-widgets",
    },
    {
        title: "A clipboard that remembers",
        body: "De-duplicated, persistent clipboard history, the same history the shell's launcher searches.",
        lib: "service-clipboard",
    },
];
---

<BaseLayout
    title="Cresset — the file explorer for the Phosphor desktop"
    description="Cresset is the planned file explorer for the Phosphor desktop. Nothing of it exists yet beyond its name and icon."
>
    <main id="main" class="container app-page">

        <AppHero app="cresset">
            <p>
                Cresset will be the file explorer for the Phosphor desktop. A
                cresset is an iron basket of burning fuel raised on a pole to
                light the way, the beacon its icon shows.
            </p>
            <Button slot="actions" href="/libraries/service-icontheme/" variant="primary">phosphor-service-icontheme library</Button>
            <Button slot="actions" href="/libraries/">All libraries</Button>
        </AppHero>

        <div class="status-note" role="note">
            <p>
                <strong>Planned.</strong> Cresset does not exist yet. There is
                no code or repository, only its name and icon, and this page
                will grow as the work starts.
            </p>
        </div>

        <section class="app-section">
            <h2>What it can build on</h2>
            <p class="lede">
                These Phosphor libraries already exist and cover parts of what a
                file explorer needs: icons for files and folders, controls, and
                a clipboard.
            </p>
            <ul class="feature-grid">
                {BUILD_ON.map((f, i) => (
                    <li class="feature" style={`--t: ${i / (BUILD_ON.length - 1)}`}>
                        <h3>{f.title}</h3>
                        <p>{f.body}</p>
                        <a class="feature-more" href={`/libraries/${f.lib}/`}>phosphor-{f.lib} →</a>
                    </li>
                ))}
            </ul>
        </section>

    </main>
</BaseLayout>
