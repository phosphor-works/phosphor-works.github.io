import BaseLayout from "../../layouts/BaseLayout.astro";
import PlannedApp from "../../components/PlannedApp.astro";
import "../../styles/home.css";
---

<BaseLayout
    title="Cresset — the file explorer for the Phosphor desktop"
    description="Cresset is the planned file explorer for the Phosphor desktop."
>
    <main id="main" class="container app-page">
        <PlannedApp app="cresset">
            <p>
                Cresset will be the file explorer of the Phosphor desktop. A cresset is an iron basket of burning fuel raised on a pole to light the way, the beacon its icon shows.
            </p>
        </PlannedApp>
    </main>
</BaseLayout>
