---
// SPDX-FileCopyrightText: 2026 fuddlesworth
// SPDX-License-Identifier: GPL-3.0-or-later
//
// /afterglow/<doc>/ — one page per Markdown file in Afterglow's docs/
// folder, read from the submodules/afterglow checkout through the
// `afterglowDocs` collection.  The docs README becomes /afterglow/docs/.
// Titles and link rewriting come from src/lib/remark-afterglow-docs.mjs;
// the sidebar order lives in src/data/nav.ts.

import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../../components/PageHero.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import Sidebar from "../../components/Sidebar.astro";
import GuideToc from "../../components/GuideToc.astro";
import PrevNext from "../../components/PrevNext.astro";
import type { TocEntry } from "../../lib/toc";
import "../../styles/home.css";
import "../../styles/guide.css";

export async function getStaticPaths() {
    const docs = await getCollection("afterglowDocs");
    return docs.map(entry => ({
        params: { doc: entry.id === "readme" ? "docs" : entry.id },
        props: { entry },
    }));
}

const { entry } = Astro.props;
const { Content, headings, remarkPluginFrontmatter } = await render(entry);
const title: string = remarkPluginFrontmatter.title ?? entry.id;
const source = `https://github.com/phosphor-works/Afterglow/blob/main/docs/${entry.filePath?.split("/").pop()}`;

const toc: TocEntry[] = headings
    .filter(h => h.depth === 2 || h.depth === 3)
    .map(h => ({ level: h.depth as 2 | 3, href: `#${h.slug}`, label: h.text }));
---

<BaseLayout
    title={`${title} — Afterglow`}
    description={`Afterglow documentation: ${title}.`}
>
    <main id="main" class="container guide guide-with-sidebar">

        <Sidebar section="afterglow" />

        <article class="guide-content">
            <Breadcrumb currentLabel={title} />
            <PageHero title={title} />

            <div class="doc-body">
                <Content />
            </div>

            <p class="doc-source muted">
                Mirrored from <a href={source}>docs/{source.split("/").pop()}</a> in the Afterglow repository.
            </p>

            <PrevNext section="afterglow" />
        </article>

        <GuideToc entries={toc} />
    </main>
</BaseLayout>

<style>
    .doc-body :global(.expressive-code) { margin: var(--space-4) 0 var(--space-5); }
    .doc-source {
        margin-top: var(--space-8);
        padding-top: var(--space-4);
        border-top: 1px solid var(--border);
    }
</style>
