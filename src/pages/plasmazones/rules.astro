        overflow-x: auto;
        border: 1px solid var(--border);
        border-radius: var(--radius-sm);
        background: var(--card);
        margin: var(--space-3) 0;
    }
    .ref-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 13px;
        min-width: 420px;
    }
    .ref-table th,
    .ref-table td {
        text-align: left;
        padding: 7px 12px;
        border-bottom: 1px solid var(--border);
        vertical-align: top;
    }
    .ref-table thead th {
        background: var(--card-high);
        color: var(--fg-dim);
        font-size: 11px;
        font-weight: 600;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        white-space: nowrap;
    }
    .ref-table tbody tr:last-child td {
        border-bottom: none;
    }
    .field-group {
        margin: var(--space-3) 0;
    }
    .field-group h4 {
        margin: 0 0 2px;
        font-size: 14px;
        color: var(--fg);
    }
    .field-blurb {
        margin: 0 0 var(--space-2);
        font-size: 12.5px;
    }
    .field-list {
        display: flex;
        flex-wrap: wrap;
        gap: 4px;
        margin: 0;
    }
    .field-chip {
        font-family: 'JetBrains Mono', ui-monospace, monospace;
        font-size: 11.5px;
        color: var(--link);
        background: var(--card-high);
        border: 1px solid var(--border);
        border-radius: var(--radius-xs);
        padding: 2px 6px;
    }
</style>
