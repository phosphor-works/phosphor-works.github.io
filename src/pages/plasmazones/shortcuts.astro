//
// Keyboard shortcut reference for PlasmaZones.
// Defaults sourced from src/config/configdefaults*.h (the scrolling
// family lives in configdefaults_scrolling_shortcuts.h) and
// src/daemon/controllers/shortcutmanager.cpp in the PlasmaZones repo.

import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../../components/PageHero.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import Sidebar from "../../components/Sidebar.astro";
import GuideToc from "../../components/GuideToc.astro";
import PrevNext from "../../components/PrevNext.astro";
import { extractGuideHeadings } from "../../lib/toc";
import "../../styles/home.css";
import "../../styles/guide.css";

const toc = extractGuideHeadings(import.meta.url);

interface Shortcut {
    binding: string;
    action: string;
    note?: string;
}

const CORE: Shortcut[] = [
    { binding: "Meta+Shift+E",    action: "Open zone editor" },
    { binding: "Meta+Shift+P",    action: "Open settings" },
    { binding: "Meta+Shift+T",    action: "Cycle the focused screen's placement mode",
      note: "Walks snapping → tiling → scrolling, skipping any mode you have disabled." },
    { binding: "Meta+Alt+/",      action: "Open the shortcut cheatsheet" },
    { binding: "Meta+Alt+[",      action: "Previous layout on current screen" },
    { binding: "Meta+Alt+]",      action: "Next layout on current screen" },
    { binding: "Meta+Alt+Space",  action: "Open layout picker" },
    { binding: "Meta+Ctrl+L",     action: "Toggle layout lock" },
    { binding: "Meta+Ctrl+Z",     action: "Reapply current layout" },
];

const FOCUS_MOVE: Shortcut[] = [
    { binding: "Alt+Shift+←/→/↑/↓",           action: "Focus window in adjacent zone" },
    { binding: "Meta+Alt+Shift+←/→/↑/↓",      action: "Move focused window into adjacent zone" },
    { binding: "Meta+Ctrl+Alt+←/→/↑/↓",       action: "Swap focused window with window in adjacent zone" },
    { binding: "Meta+Alt+, / Meta+Alt+.",     action: "Cycle focused window backward / forward through zones" },
    { binding: "Meta+Ctrl+] / Meta+Ctrl+[",   action: "Rotate all windows clockwise / counter-clockwise within current layout" },
    { binding: "Meta+Alt+Return",             action: "Push focused window to the nearest empty zone" },
    { binding: "Meta+Alt+Escape",             action: "Restore focused window to its pre-snap size" },
    { binding: "Meta+F",                      action: "Toggle focused window's floating state" },
    { binding: "Meta+Alt+X",                  action: "Switch focus between the floating windows and the placed ones",
      note: "Mode-neutral: it returns to the tiled windows on a tiling screen and to the columns on a scrolling one." },
];

const SNAP: Shortcut[] = [
    { binding: "Meta+Ctrl+1 … Meta+Ctrl+9",   action: "Snap focused window to zone 1…9 on current screen" },
    { binding: "Meta+Ctrl+S",                 action: "Snap every visible window to its best-fit zone" },
];

const LAYOUT: Shortcut[] = [
    { binding: "Meta+Alt+1 … Meta+Alt+9",     action: "Load quick-layout slot 1…9",
      note: "Slots are defined in ~/.config/plasmazones/assignments.json; assign in the layout picker." },
];

const AUTOTILE: Shortcut[] = [
    { binding: "Meta+Shift+M",        action: "Focus the master window" },
    { binding: "Meta+Shift+Return",   action: "Swap focused window with master" },
    { binding: "Meta+Shift+L / Meta+Shift+H", action: "Increase / decrease master ratio" },
    { binding: "Meta+Ctrl+= / Meta+Ctrl+-",   action: "Increase / decrease master count" },
    { binding: "Meta+Ctrl+T",         action: "Retile all windows" },
];

// The scrolling family, all on Meta+Alt.  The plain and wrapping
// directional variants ship unbound — the generic focus chords
// already walk columns and cross monitors at the strip edge — so
// they are noted in the section subtitle rather than listed with an
// empty binding.
const SCROLLING: Shortcut[] = [
    { binding: "Meta+wheel",             action: "Focus the next / previous column and slide the strip",
      note: "Horizontal wheel ticks and two-finger horizontal touchpad scrolls work too. Switchable, and invertible, under Settings → Scrolling → Window." },
    { binding: "Meta+Alt+Home / End",    action: "Focus the first / last column on the strip" },
    { binding: "Meta+Alt+Shift+Home / End", action: "Move the focused column to the start / end of the strip" },
    { binding: "Meta+Alt+V / Shift+V",   action: "Focus the first / last window in the column" },
    { binding: "Meta+Alt+Y / Shift+Y",   action: "Page the view back / forward along the strip" },
    { binding: "Meta+Alt+C",             action: "Center the focused column" },
    { binding: "Meta+Alt+Shift+C",       action: "Center all visible columns" },
    { binding: "Meta+Alt+PgUp / PgDown", action: "Cycle the column through the template's width presets, forward / back" },
    { binding: "Meta+Alt+W / Shift+W",   action: "Widen / narrow the column freely" },
    { binding: "Meta+Alt+F",             action: "Maximize the column to the full strip width" },
    { binding: "Meta+Alt+E / Shift+E",   action: "Expand the column to the free space / shrink it to its minimum" },
    { binding: "Meta+Ctrl+Shift+T",      action: "Equalize the widths of all columns" },
    { binding: "Meta+Alt+Shift+F",       action: "Toggle windowed fullscreen for the focused window" },
    { binding: "Meta+Alt+I / Shift+I",   action: "Consume the next window into this column / expel the focused one into its own" },
    { binding: "Meta+Alt+U / O",         action: "Consume or expel toward the start / end of the strip",
      note: "One key each way: it consumes the neighbour when there is one to take, and expels the focused window when there isn't." },
    { binding: "Meta+Alt+T",             action: "Toggle the column between sharing and tabbing its windows" },
    { binding: "Meta+Alt+H / Shift+H",   action: "Grow / shrink the window's share of the column" },
    { binding: "Meta+Alt+Shift+PgUp / PgDown", action: "Cycle the window height through the template's height presets" },
    { binding: "Meta+Ctrl+Alt+T",        action: "Reset every window height in the column" },
];

const VIRTUAL_SCREEN: Shortcut[] = [
    { binding: "Meta+Ctrl+Shift+←/→/↑/↓",     action: "Swap virtual screens in that direction",
      note: "Virtual screens subdivide a physical monitor into 2–10 logical workspaces, each with its own layout." },
    { binding: "Meta+Ctrl+Shift+] / Meta+Ctrl+Shift+[",
      action: "Rotate virtual screens clockwise / counter-clockwise" },
];

const SECTIONS: { title: string; id: string; subtitle?: string; rows: Shortcut[] }[] = [
    { title: "Core",               id: "core",          rows: CORE },
    { title: "Zone focus + movement", id: "focus-move", rows: FOCUS_MOVE },
    { title: "Snap",               id: "snap",          rows: SNAP },
    { title: "Layouts",            id: "layouts",       rows: LAYOUT },
    { title: "Tiling",             id: "autotile",
      subtitle: "Assign Tiling to a screen (or cycle to it with Meta+Shift+T), then pick one of the 27 built-in algorithms or a custom Luau one in Settings. Master+Stack, BSP, Spiral, Grid, and Monocle are the common picks.",
      rows: AUTOTILE },
    { title: "Scrolling",          id: "scrolling",
      subtitle: "Assign Scrolling to a screen and the whole vocabulary lives on Meta+Alt. Four directional variants ship unbound — a stop-at-the-edge and a wrapping pair for the previous and next column — for users who want niri's exact edge behaviour; bind them under Shortcuts.Scrolling in ~/.config/plasmazones/config.json.",
      rows: SCROLLING },
    { title: "Virtual screens",    id: "virtual-screens", rows: VIRTUAL_SCREEN },
];
---

<BaseLayout
    title="Shortcuts — PlasmaZones"
    description="Default keyboard shortcuts for PlasmaZones: drag-snap, zone navigation, layout cycling, tiling, the Meta+Alt scrolling family, and virtual screens."
>
    <main id="main" class="container guide guide-with-sidebar">

        <Sidebar section="plasmazones" />

        <article class="guide-content">

        <Breadcrumb />

        <PageHero
            title="Keyboard shortcuts"
            tagline="Default bindings; all remappable in System Settings › Shortcuts › PlasmaZones."
        >
            <p class="lede">
                Shortcuts are registered through
                <a href="/libraries/shortcuts/"><code>phosphor-shortcuts</code></a>:
                KGlobalAccel with component key
                <code>plasmazonesd</code>, or an XDG Portal fallback
                in the portable build
                (<code>-DUSE_KDE_FRAMEWORKS=OFF</code>). Settings are
                keyed by action ID, so rebinding one never touches
                another.
            </p>
        </PageHero>

        <h2 id="drag">Drag to snap</h2>
        <p class="muted">
            The drag and span modifiers aren't keyboard shortcuts;
            they're settings. Hold the drag modifier while moving
            a window to pop the zone overlay, and hold the span
            modifier over two adjacent zones to snap across both.
        </p>
        <ul class="shortcut-list">
            <li class="card-surface">
                <span class="shortcut-action">
                    Drag modifier
                    <span class="shortcut-note">
                        Configurable to Meta, Ctrl+Alt, Alt+Shift,
                        Alt+Meta, or Ctrl+Alt+Meta.
                    </span>
                </span>
                <code class="shortcut-binding">Alt</code>
            </li>
            <li class="card-surface">
                <span class="shortcut-action">
                    Zone-span modifier
                    <span class="shortcut-note">
                        Hold while dragging across two adjacent
                        zones to snap across both.
                    </span>
                </span>
                <code class="shortcut-binding">Ctrl+Alt</code>
            </li>
        </ul>

        {SECTIONS.map(s => (
            <Fragment>
                <h2 id={s.id}>{s.title}</h2>
                {s.subtitle && <p class="muted">{s.subtitle}</p>}
                <ul class="shortcut-list">
                    {s.rows.map(r => (
                        <li class="card-surface">
                            <span class="shortcut-action">
                                {r.action}
                                {r.note && <span class="shortcut-note">{r.note}</span>}
                            </span>
                            <code class="shortcut-binding">{r.binding}</code>
                        </li>
                    ))}
                </ul>
            </Fragment>
        ))}

        <h2 id="rebinding">Rebinding</h2>
        <p class="muted">
            Every action has a stable ID assigned by
            <a href="/libraries/shortcuts/"><code>phosphor-shortcuts</code></a>'s
            <code>ShortcutManager</code>, defined in
            <code>src/daemon/controllers/shortcutmanager.cpp</code> in the
            PlasmaZones repo. Users rebind per-action via
            System Settings › Keyboard › Shortcuts →
            <b>PlasmaZones</b>, which writes to
            <code>~/.config/kglobalshortcutsrc</code>. Overrides
            take effect the next time the daemon reloads, either
            on PlasmaZones start or after the
            <code>Meta+Ctrl+Z</code> "Reapply layout" shortcut
            above.
        </p>

            <PrevNext section="plasmazones" />
        </article>

        <GuideToc entries={toc} />
            </main>
</BaseLayout>
