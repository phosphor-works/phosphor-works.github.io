---
// SPDX-FileCopyrightText: 2026 fuddlesworth
// SPDX-License-Identifier: GPL-3.0-or-later
//
// /plasmazones/ — showcase page for the flagship consumer of the
// Phosphor suite.  Describes what the product is, what it does,
// how to install it, and how it uses the libraries documented
// elsewhere on this site.

import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { Code } from "astro-expressive-code/components";
import HeroLogoDark from "../../components/HeroLogoDark.astro";
import HeroLogoLight from "../../components/HeroLogoLight.astro";
import Card from "../../components/Card.astro";
import CardGrid from "../../components/CardGrid.astro";
import HeroCard from "../../components/HeroCard.astro";
import Button from "../../components/Button.astro";
import { FEATURED_METHODS } from "../../data/plasmazones/install";
import "../../styles/home.css";

// Screenshot auto-discovery.  Drop a PNG/JPG/WebP into
// src/assets/plasmazones/ with a filename matching the SHOTS/editor
// entries below and the tile auto-swaps from placeholder to a real
// <Image>.  Astro emits width/height/hashed URL at build time.
const screenshotModules = import.meta.glob<{ default: ImageMetadata }>(
    "../../assets/plasmazones/*.{png,jpg,jpeg,webp,avif}",
    { eager: true }
);
const resolveScreenshot = (filename: string): ImageMetadata | undefined => {
    const key = `../../assets/plasmazones/${filename}`;
    return screenshotModules[key]?.default;
};
const heroScreenshot = resolveScreenshot("editor.png");

const jsonLd = {
    "@type": "SoftwareApplication",
    name: "PlasmaZones",
    description: "Window snapping, tiling and scrolling for KDE Plasma, built on the Phosphor library suite.",
    applicationCategory: "DesktopEnhancement",
    operatingSystem: "Linux",
    url: "https://phosphor-works.github.io/plasmazones/",
    downloadUrl: "https://github.com/fuddlesworth/PlasmaZones/releases/latest",
    license: "https://spdx.org/licenses/GPL-3.0-or-later.html",
    offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
};

const FEATURES = [
    {
        title: "Snapping",
        body: "Hold a modifier while dragging any window. Zones light up, and " +
              "dropping a window into one fills it. The modifier is configurable (Alt, Meta, Ctrl+Alt, " +
              "Alt+Shift, Alt+Meta, Ctrl+Alt+Meta), and Ctrl+Alt over two " +
              "adjacent zones snaps across both. Keyboard users skip the drag " +
              "with Meta+Ctrl+1 through Meta+Ctrl+9.",
    },
    {
        title: "Tiling",
        body: "Windows place themselves as they open, with no drag and no zones " +
              "to draw. 27 algorithms ship in-box — master-and-stack, BSP, " +
              "columns, grid, spiral, monocle, Krohnkite-style deck stacking — " +
              "written in sandboxed Luau. Per-side inner and outer gaps, " +
              "smart-gaps when only one window is tiled, and hot-reload for " +
              "custom .luau in ~/.local/share/plasmazones/algorithms/.",
    },
    {
        title: "Scrolling",
        body: "Windows form columns on an endless strip, modeled on niri, and " +
              "the screen is a window onto it — opening a window never resizes " +
              "the ones you have. Columns cycle through width presets, share " +
              "or tab their windows, and consume or expel between each other. " +
              "The strip runs side to side or top to bottom to match the " +
              "monitor, and Meta+wheel moves along it.",
    },
    {
        title: "One mode per screen",
        body: "Each monitor runs the mode you assign it, scoped per virtual " +
              "desktop and per activity, so a widescreen can scroll while the " +
              "laptop panel tiles. Meta+Shift+T cycles the focused screen " +
              "through whichever modes you have enabled, and any mode can be " +
              "turned off entirely.",
    },
    {
        title: "26 built-in layouts, custom editor",
        body: "Grids, BSP and fibonacci, master+stack, portrait / ultrawide / " +
              "super-ultrawide variants, priority grids. The visual editor " +
              "draws custom zones freehand with grid snapping, undo/redo, " +
              "and per-zone colors. Coordinates are normalized, so one " +
              "layout works at any screen size.",
    },
    {
        title: "Virtual screens",
        body: "Subdivide a physical monitor into 2–10 virtual screens with " +
              "drag-to-resize boundaries. Each gets its own layout, placement " +
              "mode, and settings. Swap with Meta+Ctrl+Shift+arrows.",
    },
    {
        title: "Three shader families",
        body: "27 overlay shaders draw zone highlights, snap previews, and drag " +
              "ghosts; 24 surface packs blur, frost, border, and tint the " +
              "windows themselves; 94 animation packs cover open, close, " +
              "minimize, tab, and desktop-switch transitions. All GLSL, all " +
              "hot-reloading from ~/.local/share/plasmazones/.",
    },
    {
        title: "Window rules",
        body: "Match on class, title, active layout, screen orientation, and " +
              "more, then act on placement, floating, opacity, borders, " +
              "animations, scroll speed, and per-app behavior in every mode.",
    },
    {
        title: "Snap assist",
        body: "After you drop a window into a zone, empty zones show thumbnails " +
              "of other windows for one-click follow-up placement.",
    },
    {
        title: "Global shortcuts",
        body: "Snap, switch zones, move windows, cycle layouts, drive the strip " +
              "— bound through KGlobalAccel, with an XDG Portal fallback in " +
              "the portable build.",
    },
];



// Screenshot gallery.  Drop files into public/plasmazones/ with these
// exact names; tiles become live the moment the image exists.  Order
// is overview → interaction → configuration → customization.
const SHOTS = [
    {
        file: "snap-preview.png",
        title: "Snap preview",
        caption: "A shader-driven drop target shown while dragging. It stays steady instead of flashing.",
    },
    {
        file: "zone-highlights.png",
        title: "Active zones",
        caption: "Zone outlines fade in on modifier and fade out on release, so nothing sits on screen when you don't need it.",
    },
    {
        file: "multi-desktop.png",
        title: "Per-screen, per-desktop",
        caption: "Assign a different mode and layout to each monitor, virtual desktop, and activity; quick-layouts bind 1–9.",
    },
    {
        file: "shaders.png",
        title: "Shader presets",
        caption: "Multipass ShaderEffect with presets you can swap, tweak, or replace with your own GLSL.",
    },
    {
        file: "tiling-algos.png",
        title: "Tiling algorithms",
        caption: "Binary-split, columns, and master-stack are three of the 27 built in, with a Luau sandbox for anything custom.",
    },
    {
        file: "shortcuts.png",
        title: "Global shortcuts",
        caption: "Snap, switch zones, and cycle layouts via global keyboard shortcuts.",
    },
];

// Libraries consumed by PlasmaZones (all of them, but the page calls out
// what each one contributes at the product level).
const CONSUMED = [
    { slug: "zones",          role: "Zone model + JSON layout persistence" },
    { slug: "tiles",          role: "Tiling algorithm vocabulary + Luau sandbox" },
    { slug: "snap-engine",    role: "Manual zone placement engine" },
    { slug: "tile-engine",    role: "Autotile placement engine" },
    { slug: "scroll-engine",  role: "Scrolling-strip placement engine" },
    { slug: "engine",         role: "Shared placement-engine contracts" },
    { slug: "placement",      role: "Window tracking + auto-snap + resnap" },
    { slug: "layout-api",     role: "Layout-producer interfaces" },
    { slug: "animation",      role: "Motion curves + transition profiles" },
    { slug: "rules",          role: "Window/context rule matching + actions" },
    { slug: "shaders",        role: "Overlay shader-pack registry + parameters" },
    { slug: "surface",        role: "Per-window shader effects + decoration profiles" },
    { slug: "rendering",      role: "Multipass shader effects" },
    { slug: "wayland",        role: "Wayland integration + QPA plugin" },
    { slug: "layer",          role: "Layer-shell overlay surfaces" },
    { slug: "surfaces",       role: "Overlay surface lifecycle" },
    { slug: "overlay",        role: "Per-screen shell hosts + slot map" },
    { slug: "shell-patterns", role: "Named UI-pattern Role recipes" },
    { slug: "compositor",     role: "Plugin SDK for non-KWin compositors" },
    { slug: "shortcuts",      role: "Global keyboard shortcut registration" },
    { slug: "identity",       role: "Stable cross-process window handles" },
    { slug: "screens",        role: "Multi-monitor topology + virtual screens" },
    { slug: "workspaces",     role: "Virtual desktops + activities" },
    { slug: "config",         role: "Pluggable configuration backend" },
    { slug: "fsloader",       role: "Filesystem-watched JSON loaders" },
];
---

<BaseLayout
    title="PlasmaZones — Window snapping, tiling and scrolling for KDE Plasma"
    description="PlasmaZones: three window placement modes for KDE Plasma — snapping into zones you drew, automatic tiling, and a niri-style scrolling strip."
    jsonLd={jsonLd}
>
    <main id="main" class="container pz-page">

        <HeroCard
            title="PlasmaZones"
            tagline="Window snapping, tiling and scrolling for KDE Plasma."
        >
            <HeroLogoDark slot="logo" class="logo" />
            <HeroLogoLight slot="logo" class="logo" />
            <p class="blurb">
                Three placement modes in one daemon. Snap windows into zones
                you drew, let an algorithm tile them for you, or scroll them
                along an endless strip — every monitor picks its own. Built
                on the <a href="/libraries/">Phosphor library suite</a>, it
                is scriptable, themeable, and Wayland-native.
            </p>
            <Button slot="actions" href="/plasmazones/install/" variant="primary">Install →</Button>
            <Button slot="actions" href="/plasmazones/getting-started/">Getting started</Button>
            <Button slot="actions" href="https://github.com/fuddlesworth/PlasmaZones">Source</Button>
        </HeroCard>

        <!-- Hero screenshot.  Drop src/assets/plasmazones/editor.png
             to replace the placeholder automatically.  Astro optimizes
             and emits width/height for CLS-safe rendering. -->
        <section class="pz-screens">
            <figure class="pz-screen pz-screen-hero card-surface">
                {heroScreenshot
                    ? <Image src={heroScreenshot} alt="PlasmaZones layout editor" loading="eager" />
                    : <div class="pz-screen-placeholder">
                        <span>Hero screenshot</span>
                        <small>src/assets/plasmazones/editor.png</small>
                    </div>
                }
                <figcaption>
                    The layout editor. Named zones designed visually, with
                    normalized coordinates so the same layout works at any
                    screen size.
                </figcaption>
            </figure>
        </section>

        <section>
            <h2>Features</h2>
            <CardGrid min="280px">
                {FEATURES.map(f => (
                    <Card title={f.title} padding="var(--space-4) var(--space-5)">
                        <p>{f.body}</p>
                    </Card>
                ))}
            </CardGrid>
        </section>

        <section>
            <h2>See it in action</h2>
            <p class="lede">
                Tiles auto-swap placeholder → real image as soon as the
                PNG lands under <code>src/assets/plasmazones/</code>
                with the listed filename. No code edit needed.
            </p>
            <div class="pz-gallery card-grid">
                {SHOTS.map(s => {
                    const img = resolveScreenshot(s.file);
                    return (
                        <figure class="pz-shot card-surface">
                            {img
                                ? <Image src={img} alt={s.title} loading="lazy" />
                                : <div class="pz-screen-placeholder">
                                    <span>{s.title}</span>
                                    <small>src/assets/plasmazones/{s.file}</small>
                                </div>
                            }
                            <figcaption>
                                <strong>{s.title}</strong>
                                <span>{s.caption}</span>
                            </figcaption>
                        </figure>
                    );
                })}
            </div>
        </section>

        <!-- Teaser only.  The full instructions live at
             /plasmazones/install/ — this keeps the #install anchor
             working for the README and for links already in the wild,
             and shows the two most common methods without letting a
             second copy of the commands drift from the real page. -->
        <section id="install">
            <h2>Install</h2>
            <p class="lede">
                Packages for Arch, Fedora, openSUSE and Nix, a portable
                tarball for immutable systems, or a source build.
                Needs Plasma 6.7+ on Wayland.
            </p>
            <div class="install-quick">
                {FEATURED_METHODS.map(method => (
                    <div class="install-quick-item">
                        <h3>{method.label}</h3>
                        <Code lang="bash" code={method.code} wrap />
                    </div>
                ))}
            </div>
            <p class="install-more">
                <Button href="/plasmazones/install/" variant="primary">
                    All install methods →
                </Button>
                <span class="muted">
                    openSUSE, Nix, portable tarball, source build,
                    requirements, and the post-install step.
                </span>
            </p>
        </section>

        <section>
            <h2>Galleries</h2>
            <p class="lede">
                Every built-in, rendered from the same metadata the
                daemon reads at runtime.
            </p>
            <ul class="links">
                <li>
                    <a href="/plasmazones/layouts/">Layouts →</a>
                    <span class="muted">26 built-in layouts with live-rendered SVG thumbnails, grouped by aspect ratio. The snapping mode's vocabulary.</span>
                </li>
                <li>
                    <a href="/plasmazones/autotile/">Autotile algorithms →</a>
                    <span class="muted">27 tiling algorithms grouped by family, with supported parameters and stateful flags.</span>
                </li>
                <li>
                    <a href="/plasmazones/scrolling/">Scrolling →</a>
                    <span class="muted">How the strip works, plus the three bundled column templates and the Meta+Alt shortcut family.</span>
                </li>
                <li>
                    <a href="/plasmazones/shaders/">Overlay shaders →</a>
                    <span class="muted">27 GLSL overlays across 6 categories, with tags and parameter counts.</span>
                </li>
                <li>
                    <a href="/plasmazones/surface/">Surface shaders →</a>
                    <span class="muted">24 per-window packs: blur and glass, border families, ambience, and focus treatments.</span>
                </li>
                <li>
                    <a href="/plasmazones/animations/">Animations →</a>
                    <span class="muted">94 transition packs for window open, close, minimize, tab switch, and desktop change.</span>
                </li>
            </ul>
        </section>

        <section>
            <h2>Learn</h2>
            <ul class="links">
                <li>
                    <a href="/plasmazones/getting-started/">Getting started →</a>
                    <span class="muted">A first-run tour from verifying the install to snapping your first window.</span>
                </li>
                <li>
                    <a href="/plasmazones/shortcuts/">Keyboard shortcuts →</a>
                    <span class="muted">Default bindings and how to rebind each one.</span>
                </li>
                <li>
                    <a href="/plasmazones/from-fancyzones/">Coming from FancyZones →</a>
                    <span class="muted">Feature-by-feature map for the PowerToys → Plasma jump.</span>
                </li>
            </ul>
        </section>

        <section>
            <h2>Extend it</h2>
            <p class="lede">
                Layouts, algorithms, scrolling templates, and all three
                shader families are user-extensible. Custom content goes in
                <code>~/.local/share/plasmazones/</code> and hot-reloads on
                save.
            </p>
            <ul class="links">
                <li>
                    <a href="/guides/shaders/">Shader authoring guide →</a>
                    <span class="muted">GLSL 450 uniform contract, metadata schema, audio reactivity, multipass.</span>
                </li>
                <li>
                    <a href="/guides/tiling/">Tiling algorithm guide →</a>
                    <span class="muted">The pluau standard library, the sandbox contract, metadata, hot-reload.</span>
                </li>
            </ul>
        </section>

        <section>
            <h2>Advanced</h2>
            <ul class="links">
                <li>
                    <a href="/plasmazones/dbus/">D-Bus scripting →</a>
                    <span class="muted">17 interfaces on org.plasmazones, with recipes and signal watching.</span>
                </li>
                <li>
                    <a href="/plasmazones/troubleshooting/">Troubleshooting →</a>
                    <span class="muted">Daemon won't start, zones not appearing, support reports.</span>
                </li>
                <li>
                    <a href="/plasmazones/changelog/">Changelog →</a>
                    <span class="muted">Every tagged release with its full notes, mirrored from the project's CHANGELOG.md.</span>
                </li>
            </ul>
        </section>

        <section>
            <h2>Built on Phosphor</h2>
            <p class="lede">
                Every major subsystem is its own library. Fixes land once and
                reach every consumer, and third-party code can depend on only
                the pieces it needs.
            </p>
            <CardGrid min="280px" gap="var(--space-2)">
                {CONSUMED.map(c => (
                    <Card href={`/libraries/${c.slug}/`} padding="var(--space-3) var(--space-4)">
                        <code slot="title">phosphor-{c.slug}</code>
                        <span>{c.role}</span>
                    </Card>
                ))}
            </CardGrid>
        </section>

        </main>
</BaseLayout>

<style>
    .pz-page { padding-top: var(--space-7); }


    .pz-screens { margin-bottom: var(--space-8); }
    /* .pz-screen and .pz-shot both compose .card-surface; only the
       overflow and figure-reset live here. */
    .pz-screen,
    .pz-shot {
        margin: 0;
        overflow: hidden;
    }
    .pz-screen img,
    .pz-shot img { display: block; width: 100%; height: auto; }
    .pz-screen figcaption,
    .pz-shot figcaption {
        padding: var(--space-3) var(--space-4);
        border-top: 1px solid var(--border);
        font-size: var(--font-ui);
        color: var(--fg-dim);
        line-height: 1.55;
    }
    .pz-shot figcaption {
        display: flex;
        flex-direction: column;
        gap: var(--space-1);
        font-size: 12.5px;
    }
    .pz-shot figcaption strong {
        color: var(--fg);
        font-size: 13.5px;
        font-weight: 600;
    }
    .pz-screen-placeholder {
        aspect-ratio: 16 / 9;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        color: var(--fg-muted);
        font-family: 'JetBrains Mono', ui-monospace, monospace;
        font-size: var(--font-ui);
        gap: 6px;
        background:
            linear-gradient(135deg, rgba(59,130,246,0.06), rgba(168,85,247,0.06)),
            var(--card);
    }
    .pz-screen-placeholder small { font-size: var(--font-eyebrow); opacity: 0.7; }

    .pz-gallery { margin-top: var(--space-4); }

    /* Heading row inside each install tab — link on top, note
       below.  Stacks the two so the destination link is the
       visual anchor and the source description sits as caption. */
    .install-note {
        display: flex;
        flex-direction: column;
        gap: var(--space-1);
        margin: 0 0 var(--space-3);
    }
    .install-note a {
        color: var(--link);
        font-weight: 600;
        text-decoration: none;
        font-size: 14px;
    }
    .install-note a:hover { text-decoration: underline; }
    .install-note span {
        color: var(--fg-dim);
        font-size: 12px;
    }


    /* Install teaser: the two featured methods side by side, then a
       clear route to the full page. */
    .install-quick {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
        gap: var(--space-3);
        margin-bottom: var(--space-4);
    }
    .install-quick-item h3 {
        margin: 0 0 var(--space-2);
        font-size: var(--font-ui);
        color: var(--fg-dim);
        font-weight: 600;
    }
    .install-more {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: var(--space-3);
    }
    .install-more .muted { font-size: var(--font-ui); }
</style>
