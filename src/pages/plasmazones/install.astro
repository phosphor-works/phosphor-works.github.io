---
// SPDX-FileCopyrightText: 2026 fuddlesworth
// SPDX-License-Identifier: GPL-3.0-or-later
//
// /plasmazones/install/ — the canonical install page.
//
// Previously this lived only as an #install anchor a third of the way
// down the /plasmazones/ landing, behind a tab control and below a
// screenshot gallery, with no link in the topbar.  It now has its own
// URL so packaging pages, bug reports, and the README can point at
// something stable, and so it shows up in site search as its own
// result.  The landing page keeps a short teaser at #install that
// links here; both read INSTALL_METHODS from src/data/plasmazones/
// install.ts so they cannot drift.

import BaseLayout from "../../layouts/BaseLayout.astro";
import { Code } from "astro-expressive-code/components";
import PageHero from "../../components/PageHero.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import Sidebar from "../../components/Sidebar.astro";
import GuideToc from "../../components/GuideToc.astro";
import PrevNext from "../../components/PrevNext.astro";
import Button from "../../components/Button.astro";
import { extractGuideHeadings } from "../../lib/toc";
import { INSTALL_METHODS, REQUIREMENTS, POST_INSTALL } from "../../data/plasmazones/install";
import "../../styles/home.css";
import "../../styles/guide.css";

const toc = extractGuideHeadings(import.meta.url);
---

<BaseLayout
    title="Install PlasmaZones"
    description="Install PlasmaZones on Arch, Fedora, openSUSE, or Nix, from a portable tarball, or from source — plus requirements and the post-install daemon setup."
>
    <main id="main" class="container guide guide-with-sidebar">

        <Sidebar section="plasmazones" />

        <article class="guide-content">

        <Breadcrumb />

        <PageHero
            title="Install PlasmaZones"
            tagline="Packages for Arch, Fedora, openSUSE and Nix, a portable tarball, or a source build."
        >
            <p class="lede">
                Every method below installs the same thing: a user
                daemon plus a KWin effect. Pick your distribution, then
                do the <a href="#after">post-install step</a> — the
                daemon does not start on its own.
            </p>
            <p class="muted">
                Already installed and something is wrong? Go to
                <a href="/plasmazones/troubleshooting/">troubleshooting</a>.
            </p>
        </PageHero>

        <h2 id="requirements">Requirements</h2>
        <p>Before installing, check that your desktop meets these.</p>
        <ul class="req-list">
            {REQUIREMENTS.runtime.map(item => <li>{item}</li>)}
        </ul>
        <p class="muted">
            Building from source additionally needs:
        </p>
        <ul class="req-list muted">
            {REQUIREMENTS.build.map(item => <li>{item}</li>)}
        </ul>

        <h2 id="methods">Choose a method</h2>
        <p>
            The distribution packages are the least work and keep
            PlasmaZones updated alongside the rest of your system. The
            tarball suits immutable systems such as Fedora Atomic, or
            anywhere you would rather not install as root.
        </p>

        {INSTALL_METHODS.map(method => (
            <section class="method">
                <h3 id={method.id}>{method.label}</h3>
                <p class="method-note">
                    {method.note}
                    {" "}
                    <a href={method.href}>{method.hrefLabel} →</a>
                </p>
                <Code lang="bash" code={method.code} wrap />
            </section>
        ))}

        <h3 id="nixos">NixOS module</h3>
        <p>
            On NixOS, prefer the module over <code>nix profile</code>.
            It builds against your system's KWin, so a KWin update
            cannot leave the effect plugin unable to load. Add the
            flake to your inputs:
        </p>
        <Code lang="nix" code={`plasmazones.url = "github:fuddlesworth/PlasmaZones";`} wrap />
        <p>Then import the module and enable it:</p>
        <Code lang="nix" code={`imports = [ inputs.plasmazones.nixosModules.default ];
programs.plasmazones.enable = true;`} wrap />
        <p class="muted">Rebuild, run the step below, then log out and back in.</p>

        <h2 id="after">After installing</h2>
        <p>
            Every method needs this. The daemon is a user service and
            is not started for you:
        </p>
        <Code lang="bash" code={POST_INSTALL} wrap />
        <p>
            Then check the effect is enabled under <b>System Settings →
            Window Management → Desktop Effects → PlasmaZones</b>. It is
            on by default, so this is usually just a confirmation. The
            entry is unavailable under QPainter compositing, because the
            effect needs KWin on OpenGL.
        </p>

        <h2 id="first-run">First run</h2>
        <p>
            Drag any window while holding <kbd>Alt</kbd> — zones appear,
            and dropping the window into one fills it. To try the other
            placement modes, open the settings app
            (<code>plasmazones-settings</code>, or <b>System Settings →
            Apps → PlasmaZones</b> on KDE) and assign Tiling or Scrolling
            to a screen, or press <kbd>Meta+Shift+T</kbd> to cycle the
            focused screen through them.
        </p>
        <div class="install-cta">
            <Button href="/plasmazones/getting-started/" variant="primary">
                First-run tour →
            </Button>
            <Button href="/plasmazones/shortcuts/">Keyboard shortcuts</Button>
            <Button href="/plasmazones/troubleshooting/">Troubleshooting</Button>
        </div>

            <PrevNext section="plasmazones" />
        </article>

        <GuideToc entries={toc} />

        </main>
</BaseLayout>

<style>
    .req-list {
        margin: 0 0 var(--space-4);
        padding-left: var(--space-5);
    }
    .req-list li {
        margin-bottom: var(--space-1);
        line-height: 1.6;
    }
    .method {
        margin-bottom: var(--space-5);
    }
    .method-note {
        margin: 0 0 var(--space-2);
        font-size: var(--font-ui);
        color: var(--fg-dim);
    }
    .method-note a { color: var(--link); text-decoration: none; }
    .method-note a:hover { color: var(--link-hover); }
    .install-cta {
        display: flex;
        flex-wrap: wrap;
        gap: var(--space-2);
        margin-top: var(--space-4);
    }
</style>
